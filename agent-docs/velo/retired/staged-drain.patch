+/// The payloads the messenger staged on a sender's behalf (a message over the
+/// eager budget) that this store still holds. Graceful shutdown's drain waits
+/// for them: the handle rides a message the transport already admitted, and
+/// the consumer pulls the bytes only once that message arrives, so a teardown
+/// that came first would drop work this node accepted.
+#[derive(Default)]
+pub(crate) struct TransparentStaging {
+    outstanding: AtomicUsize,
+    released: tokio::sync::Notify,
+}
+
+/// Held by a transparently staged slot: counted while it lives, and counted
+/// out however the slot goes (pulled and released, freed, dropped with its
+/// demotion, or dropped with the store), with nothing to remember at each of
+/// those sites.
+struct TransparentGuard(Arc<TransparentStaging>);
+
+impl Drop for TransparentGuard {
+    fn drop(&mut self) {
+        self.0.outstanding.fetch_sub(1, Ordering::AcqRel);
+        self.0.released.notify_waiters();
+    }
 }
 

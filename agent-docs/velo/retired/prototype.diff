+pub struct SenderClosed(Arc<SenderState>);
 
+/// Per-stream state the sender and its transport slot already share. The
+/// retirement cell rides this allocation, so a stream that nobody watches
+/// pays no allocation for it, only one uncontended store when it retires.
+#[derive(Debug, Default)]
+pub struct SenderState {
+    closed: AtomicBool,
+    /// 0 live, 1 sent, 2 discarded. First writer wins.
+    retired: std::sync::atomic::AtomicU8,
+    waker: futures::task::AtomicWaker,
+}
+
 impl SenderClosed {
     /// Mark the sender cancelled.
     pub fn close(&self) {
-        self.0.store(true, Ordering::Release);
+        self.0.closed.store(true, Ordering::Release);
     }
 
     /// Whether the sender is cancelled.
     pub fn is_closed(&self) -> bool {
-        self.0.load(Ordering::Acquire)
+        self.0.closed.load(Ordering::Acquire)
+    }
+
+    /// Record how the stream's output left this node. Idempotent: the first
+    /// outcome stands.
+    pub(crate) fn retire(&self, sent: bool) {
+        let code = if sent { 1 } else { 2 };
+        if self
+            .0
+            .retired
+            .compare_exchange(0, code, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+        {
+            self.0.waker.wake();
+        }
+    }
+
+    pub(crate) fn poll_retired(
+        &self,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<crate::streaming::sender::Retirement> {
+        use crate::streaming::sender::Retirement;
+        let read = |s: &SenderState| match s.retired.load(Ordering::Acquire) {
+            1 => Some(Retirement::Sent),
+            2 => Some(Retirement::Discarded),
+            _ => None,
+        };
+        if let Some(r) = read(&self.0) {
+            return std::task::Poll::Ready(r);
+        }
+        self.0.waker.register(cx.waker());
+        match read(&self.0) {
+            Some(r) => std::task::Poll::Ready(r),
+            None => std::task::Poll::Pending,
+        }
+    }
+}
+
+/// Fires `Discarded` when dropped unless [`sent`](Self::sent) consumed it, so
+/// a task or table that dies with the stream's output still resolves the
+/// stream's [`Retired`](crate::streaming::sender::Retired).
+pub(crate) struct RetireGuard(Option<SenderClosed>);
+
+impl RetireGuard {
+    pub(crate) fn new(closed: SenderClosed) -> Self {
+        Self(Some(closed))
+    }
+
+    pub(crate) fn sent(mut self) {
+        if let Some(closed) = self.0.take() {
+            closed.retire(true);
+        }
+    }
+}
+
+impl Drop for RetireGuard {
+    fn drop(&mut self) {
+        if let Some(closed) = self.0.take() {
+            closed.retire(false);
+        }
     }
 }
 
